interface {{$interface.Name}} {
{{range $property := $interface.Properties}}    {{$property.Name}}: {{$property.Type}};
{{end}}}
{{end}}{{range $namespace := .namespaces}}
declare const {{$namespace.Name}}: {
{{range $method := $namespace.Methods}}{{if $method.Comment}}    /**
{{range $line := $method.Comment}}     * {{$line}}
{{end}}     */
{{end}}    {{$method.Name}}({{$method.Params}}): {{$method.Result}};
{{end}}};
{{end}}
